<h1>testViewData</h1>
<h2 style="background-color: @(ViewData["Color"]?.ToString() ?? "transparent")">@Model.Name</h2>

<h3>Message : @ViewData["Message"]</h3>

<select class="form-control">
    @foreach (var item in (ViewData["brch"] as List<string>) ?? new List<string>())
    {
        <option>@item</option>
    }
</select>

<p>@((int)ViewData["Temp"] + 10)</p>